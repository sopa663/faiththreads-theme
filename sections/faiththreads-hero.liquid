
{% style %}
  .ft-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 720px;
    overflow: hidden;
    background: #191817;
    color: #fff;
  }

  .ft-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ft-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,.78), rgba(0,0,0,.12));
  }

  .ft-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: auto;
    padding: 100px 7%;
  }

  .ft-hero__eyebrow {
    font-size: 11px;
    letter-spacing: .28em;
    margin-bottom: 24px;
  }

  .ft-hero__heading {
    color: #fff;
    font-size: clamp(58px, 10vw, 130px);
    line-height: .88;
    letter-spacing: -.07em;
    max-width: 900px;
    margin: 0;
  }

  .ft-hero__description {
    max-width: 420px;
    margin: 28px 0;
    color: #e5e2dd;
    line-height: 1.7;
  }

  .ft-hero__button {
    display: inline-block;
    padding: 18px 30px;
    background: #f2eee6;
    color: #171717;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: .16em;
    transition: .25s;
  }

  .ft-hero__button:hover {
    background: #fff;
  }

  @media(max-width: 749px) {
    .ft-hero {
      min-height: 620px;
    }

    .ft-hero__overlay {
      background: linear-gradient(0deg, rgba(0,0,0,.8), rgba(0,0,0,.12));
    }

    .ft-hero__content {
      padding: 60px 24px;
    }

    .ft-hero__heading {
      font-size: clamp(52px, 13vw, 78px);
    }
  }
{% endstyle %}

<section class="ft-hero">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'ft-hero__image', loading: 'eager' }}
  {% endif %}

  <div class="ft-hero__overlay"></div>

  <div class="ft-hero__content">
    <p class="ft-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>

    <h1 class="ft-hero__heading">
      {{ section.settings.heading | escape }}
    </h1>

    <div class="ft-hero__description">
      {{ section.settings.description | escape }}
    </div>

    <a class="ft-hero__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
      {{ section.settings.button_label | escape }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "FaithThreads Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "FAITH. HOPE. LOVE."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "WEAR YOUR FAITH."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "More than what you wear. A reminder of what you believe and who you are."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "DISCOVER THE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "FaithThreads Hero"
    }
  ]
}
{% endschema %}
